{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "import/no-default-export": "error"
  },
  "overrides": [
    {
      "files": ["*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**", "contracts/**"]
}
