# Copy to .env for local development. Never commit .env.
# Full reference: docs/02-architecture.md "Configuration (env vars)".

# --- all ---
LOG_LEVEL=info
APP_VERSION=dev
DATABASE_URL=postgres://gapless:gapless@localhost:15432/gapless
METRICS_PORT=9464
CHAIN_ID=31337
# MockToken on a fresh anvil (Phase 1). The first contract that anvil account 0 deploys (nonce 0)
# always lands at this address. Change it only if account 0 sent a transaction before the deploy.
TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
SHUTDOWN_TIMEOUT_MS=20000

# --- api ---
PORT=3000

# --- indexer ---
RPC_HTTP_URL=http://localhost:8545
# Optional. Leave empty to run poll-only.
RPC_WS_URL=
# Block of the MockToken deployment (>= 1). The deploy script prints it; 1 on a fresh anvil.
START_BLOCK=1
CONFIRMATIONS=5
BATCH_SIZE=2000
POLL_INTERVAL_MS=4000
BLOCK_TIME_MS=12000
REORG_REWIND_BLOCKS=64
