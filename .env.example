# Copy to .env for local development. Never commit .env.
# Full reference: docs/02-architecture.md "Configuration (env vars)".

# --- all ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://gapless:gapless@localhost:15432/gapless
METRICS_PORT=9464
CHAIN_ID=31337
# Set after deploying MockToken on anvil (Phase 1).
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
SHUTDOWN_TIMEOUT_MS=20000

# --- api ---
PORT=3000
REDIS_URL=redis://localhost:16379

# --- indexer ---
RPC_HTTP_URL=http://localhost:8545
# Optional. Leave empty to run poll-only.
RPC_WS_URL=
# Block of the MockToken deployment.
START_BLOCK=0
CONFIRMATIONS=5
BATCH_SIZE=2000
POLL_INTERVAL_MS=4000
REORG_REWIND_BLOCKS=64
