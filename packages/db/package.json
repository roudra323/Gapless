{
  "name": "@gapless/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.0"
  },
  "exports": {
    ".": {
      "@gapless/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/bin/migrate.js"
  },
  "dependencies": {
    "@gapless/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
