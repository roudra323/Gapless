        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log lines / s by level",
      "id": 23,
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "description": "From Loki. pino writes level as a string; | json reads it from each line.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*(error|fatal)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (app_kubernetes_io_component, level) (rate({namespace=\"$namespace\", app_kubernetes_io_component=~\"indexer|api\"} | json level [$__rate_interval]))",
          "legendFormat": "{{app_kubernetes_io_component}} {{level}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Indexer warn and above",
      "description": "The indexer's warn, error and fatal lines. Open a line to see all its JSON fields.",
      "id": 24,
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 49
