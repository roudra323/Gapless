          },
          "expr": "sum by (route) (rate(gapless_http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "description": "ApiLatencyHigh fires when p95 is above 0.5 s for 10 minutes.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
